{
  "name": "newsformom",
  "version": "2.0.0",
  "private": true,
  "description": "NewsForMom — static editorial site with Decap CMS and Git-based content.",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node -e \"require('http').createServer((q,s)=>{const p=new URL(q.url,'http://localhost').pathname;require('fs').createReadStream(require('path').join('dist',p==='/'?'index.html':p)).on('error',()=>{s.statusCode=404;s.end()}).pipe(s)}).listen(8080)\""
  },
  "engines": {
    "node": ">=20"
  }
}
